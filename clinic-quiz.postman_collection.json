{
  "info": {
    "name": "clinic-quiz",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the app with the 'seed' profile, copy the doctor/patient ids from the console log into the collection variables."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "doctorId",
      "value": "PASTE-ALICE-ID-FROM-CONSOLE-LOG"
    },
    {
      "key": "patientId",
      "value": "PASTE-JEAN-ID-FROM-CONSOLE-LOG"
    }
  ],
  "item": [
    {
      "name": "Part A - derived",
      "item": [
        {
          "name": "A1 patients by last name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "by-last-name"
              ],
              "query": [
                {
                  "key": "lastName",
                  "value": "uwase"
                }
              ]
            },
            "description": "DERIVED: IgnoreCase + OrderBy first name"
          }
        },
        {
          "name": "A2 appointments by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "by-status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "SCHEDULED"
                }
              ]
            },
            "description": "DERIVED: enum + OrderBy"
          }
        },
        {
          "name": "A3 appointments between",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "between"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "2026-10-01"
                },
                {
                  "key": "end",
                  "value": "2026-10-31"
                }
              ]
            },
            "description": "DERIVED: Between"
          }
        },
        {
          "name": "A4 save appointment (409 if doctor booked)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/save",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "save"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentDate\": \"2026-10-20\",\n  \"reason\": \"Double booking test\",\n  \"status\": \"SCHEDULED\",\n  \"patient\": {\n    \"id\": \"{{patientId}}\"\n  },\n  \"doctor\": {\n    \"id\": \"{{doctorId}}\"\n  }\n}"
            },
            "description": "DERIVED: existsBy. With the seed data and Alice's id this returns 409 (she is booked on 2026-10-20)."
          }
        }
      ]
    },
    {
      "name": "Part B - JPQL joins",
      "item": [
        {
          "name": "B1 doctors by specialization",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/by-specialization?name=cardiology",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "by-specialization"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "cardiology"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "B2 doctors without office",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/without-office",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctors",
                "without-office"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "B3 unused specializations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/specializations/unused",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "specializations",
                "unused"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "B4 patients of doctor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/of-doctor/{{doctorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "of-doctor",
                "{{doctorId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "B4 patients of unknown doctor (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/of-doctor/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "of-doctor",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Part C - aggregates and bulk",
      "item": [
        {
          "name": "C1 appointments per status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/stats/by-status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "stats",
                "by-status"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "C2 frequent patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/frequent?min=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "frequent"
              ],
              "query": [
                {
                  "key": "min",
                  "value": "3"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "C3 busiest office",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/offices/busiest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "offices",
                "busiest"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "C4 cancel day",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/cancel-day?doctorId={{doctorId}}&date=2026-10-20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "cancel-day"
              ],
              "query": [
                {
                  "key": "doctorId",
                  "value": "{{doctorId}}"
                },
                {
                  "key": "date",
                  "value": "2026-10-20"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Bonus",
      "item": [
        {
          "name": "Page of appointments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/page?page=0&size=5&sort=appointmentDate,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "page"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "appointmentDate,desc"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Delete old cancellations",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/cancelled-before?date=2026-10-15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "cancelled-before"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "2026-10-15"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}